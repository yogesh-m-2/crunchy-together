{
  "manifest_version": 3,
  "name": "Otaku Sync",
  "version": "4.2.0",
  "description": "Watch anime together in sync — shared play/pause/seek, webcam, chat, GIFs and floating reactions.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.crunchyroll.com/*",
    "https://static.crunchyroll.com/*",
    "https://raw.githubusercontent.com/*",
    "https://api.giphy.com/*",
    "https://*.giphy.com/*",
    "https://api.YOURDOMAIN.com/*",
    "https://backup.YOURDOMAIN.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Otaku Sync",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.crunchyroll.com/*"],
      "js": ["net.js", "emojis.js", "room.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.crunchyroll.com/*",
        "https://static.crunchyroll.com/*"
      ],
      "js": ["player.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
