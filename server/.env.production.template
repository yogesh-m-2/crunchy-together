# Otaku Sync — live config for THIS SERVER ONLY.
# This file stays on the VPS. Never commit it, never ship it in the extension.
# deploy.sh copies it to /opt/otaku-sync/server/.env with mode 600.

PORT=8080
NODE_ENV=production

# deploy.sh fills this in automatically if left as change-me.
JWT_SECRET=change-me

TRIAL_DAYS=7

# ---- SMS / OTP -------------------------------------------------------------
# Start here: codes print to `journalctl -u otaku-sync -f`, costs nothing.
# Switch to msg91 (India) or twilio (international) before real users arrive.
SMS_PROVIDER=console

MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER=CRPRTY

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- Razorpay (TEST mode) --------------------------------------------------
# Test keys move no real money. Swap for rzp_live_* keys after KYC.
RAZORPAY_KEY_ID=rzp_test_TUGl7WIhKbZ9i2

# Paste your secret here ON THE SERVER, then: chmod 600 .env
# Because this key was shared in a chat, rotate it in the Razorpay dashboard
# (Settings > API Keys > Regenerate) and paste the fresh one instead.
RAZORPAY_KEY_SECRET=

# Subscriptions > Plans > create a monthly INR 5 plan, paste its id here.
RAZORPAY_PLAN_ID=

# Settings > Webhooks > add https://YOUR_DOMAIN/billing/webhook,
# set a secret there, paste the same value here.
RAZORPAY_WEBHOOK_SECRET=

# ---- Support ---------------------------------------------------------------
SUPPORT_WHATSAPP=+918660095124

# ---- Sign-in ---------------------------------------------------------------
# Your public HTTPS base, used to build OAuth redirect URIs. No trailing slash.
PUBLIC_URL=https://api.yogeshmallidi.com

# Devices allowed per account at once. 1 = strict single device.
MAX_DEVICES=1

# Google: console.cloud.google.com > Credentials > OAuth client (Web).
# Authorised redirect URI: https://api.yogeshmallidi.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook: developers.facebook.com > app > Facebook Login > Settings.
# Valid OAuth redirect URI: https://api.yogeshmallidi.com/auth/facebook/callback
# Note: needs App Review + Business Verification before non-testers can log in.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---- Email (verification codes) --------------------------------------------
# console | resend | brevo | smtp. Email OTP costs ~nothing worldwide.
MAIL_PROVIDER=console
MAIL_FROM=no-reply@yogeshmallidi.com
RESEND_API_KEY=
BREVO_API_KEY=

# SMTP (Gmail or any host). Gmail needs 2FA + an App Password, caps ~500/day,
# and rewrites MAIL_FROM to your Gmail address. Fine for testing; a
# transactional provider delivers login codes far more reliably.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# ---- Admin panel (node admin.js, separate process) --------------------------
# Bound to localhost by default — reach it with an SSH tunnel:
#   ssh -L 3310:127.0.0.1:3310 root@YOUR_SERVER   then http://127.0.0.1:3310
ADMIN_PORT=3310
ADMIN_BIND=127.0.0.1
ADMIN_USER=yogesh
ADMIN_PASS=pass@shreya
