# Copy to .env on the server and fill in. NEVER commit .env or ship it in the extension.

PORT=8080
NODE_ENV=production

# Long random string. Generate with: openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-string

# Trial length in days
TRIAL_DAYS=7

# ---- SMS / OTP -------------------------------------------------------------
# SMS_PROVIDER: console | msg91 | twilio
# "console" prints the OTP to the server log — use only while developing.
SMS_PROVIDER=console

# MSG91 (India, cheapest for Indian numbers)
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER=CRPRTY

# Twilio (works internationally, pricier)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX

# ---- Razorpay --------------------------------------------------------------
# Dashboard > Settings > API Keys. The SECRET stays here, never in the extension.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Subscriptions > Plans. Create a plan of INR 5 / month and paste its id (plan_XXXX).
RAZORPAY_PLAN_ID=
# Dashboard > Settings > Webhooks. Set a secret and paste the same value here.
RAZORPAY_WEBHOOK_SECRET=

# ---- Support ---------------------------------------------------------------
SUPPORT_WHATSAPP=+918660095124
